*.dSYM

# Swift Package Manager
.build/
.swiftpm/

# XcodeGen output — project.yml is the source of truth.
# Ignore the generated project, but keep the SwiftPM lockfile committed.
LooseningWorry.xcodeproj/*
!LooseningWorry.xcodeproj/project.xcworkspace/
LooseningWorry.xcodeproj/project.xcworkspace/*
!LooseningWorry.xcodeproj/project.xcworkspace/xcshareddata/
LooseningWorry.xcodeproj/project.xcworkspace/xcshareddata/*
!LooseningWorry.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
LooseningWorry.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!LooseningWorry.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
LooseningWorry/Info.plist
LooseningWorry/LooseningWorry.entitlements

